# Copy this file to .env and edit it. Everything here is optional; the app
# starts without a .env at all, with authentication switched off.
#
#   cp .env.example .env
#   docker compose up -d
#
# .env is gitignored. Never commit real credentials.
# After editing, restart the container: these are read at startup only.
#   docker compose up -d

# --- Web UI authentication ------------------------------------------------
# Leave RSSOPDS_WEB_USER blank to disable authentication entirely.
# Setting it protects the whole web UI with HTTP basic auth.
RSSOPDS_WEB_USER=
RSSOPDS_WEB_PASSWORD=

# --- OPDS authentication --------------------------------------------------
# Left blank, the OPDS catalogue reuses the web credentials above, so the one
# setting protects both. Set these to give the ereader its own, shorter
# credential -- you have to type it on a device keyboard.
RSSOPDS_OPDS_USER=
RSSOPDS_OPDS_PASSWORD=

# Some readers cannot send HTTP credentials at all. Set this to true to leave
# the OPDS catalogue open while the web UI stays protected. Only sensible on a
# network you trust: anyone who can reach the port can read your articles.
RSSOPDS_OPDS_PUBLIC=false

# --- Other -----------------------------------------------------------------
# Absolute URL the ereader should use, if the app sits behind a reverse proxy.
# Left blank, links are derived from the incoming request.
# RSSOPDS_BASE_URL=http://your-server-ip:8000

# RSSOPDS_LOG_LEVEL=INFO
